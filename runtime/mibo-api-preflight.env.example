# Private API-readiness environment for the controlled Japan-site runtime.
# Never commit real secret values.
MIBO_WAVE=MIBO-W01
MIBO_SITE=JP01
MIBO_PROVIDER_FREEZE=/srv/mibo-private/provider_freeze.W01.json
MIBO_API_EVIDENCE_DIR=/srv/mibo-private/MIBO-W01-JP01-api-preflight

# Required only when the corresponding provider is frozen as paired-eligible.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: permits Perplexity model-catalog evidence for operational awareness.
# Perplexity remains non-admissible for the v1.0 paired module.
PERPLEXITY_API_KEY=

# Metadata/catalog checks do not require this sentinel.
# Set this only after the dated API Terms/access review if a synthetic generation
# smoke test is desired.
MIBO_API_SMOKE_TEST=DISABLED
