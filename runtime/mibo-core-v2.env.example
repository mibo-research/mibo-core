# Private Core v2 runtime file; chmod 600. Never commit real values.
MIBO_CORE_V2_EXECUTION=DISABLED
MIBO_CORE_V2_WAVE=MIBO2-W01
MIBO_DATA_ROOT=/srv/mibo-data
MIBO_CORE_V2_PROTOCOL=/srv/mibo-private/core_v2_protocol.final.json
MIBO_CORE_V2_MANIFEST=/srv/mibo-private/MIBO2-W01-JP01-API-CORE.csv
MIBO_CORE_V2_FREEZE=/srv/mibo-private/core_v2_provider_freeze.W01.json
MIBO_CORE_V2_AUTHORIZATION=/srv/mibo-private/core_v2_execution_authorization.W01.json
# Required by the strict deployment gate. Use the actual controlled VM hostname
# and the full reviewed source commit of the installed snapshot, never a branch.
MIBO_RUNTIME_HOST=REPLACE_WITH_CONTROLLED_VM_HOSTNAME
MIBO_CORE_V2_SOURCE_COMMIT=REPLACE_WITH_REVIEWED_FULL_40_HEX_SOURCE_COMMIT
PYTHONDONTWRITEBYTECODE=1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
