[Unit]
Description=MIBO Core paired API executor
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=mibo
Group=mibo
WorkingDirectory=/opt/mibo-core
EnvironmentFile=/etc/mibo/mibo-paired.env
ExecStartPre=/usr/bin/python3 automation/mibo_runner.py verify-config
ExecStartPre=/usr/bin/python3 automation/manifest_integrity.py ${MIBO_MANIFEST}
ExecStart=/usr/bin/python3 automation/wave_waiter.py --wave ${MIBO_WAVE} --manifest ${MIBO_MANIFEST} --freeze ${MIBO_FREEZE} --authorization ${MIBO_AUTHORIZATION} --data-root ${MIBO_DATA_ROOT}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mibo-data /srv/mibo-private

[Install]
WantedBy=multi-user.target
