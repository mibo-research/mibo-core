# Private Japan-site Pre-Wave configuration. chmod 640 root:mibo.
# Never commit real secrets or completed private configuration records.
MIBO_WAVE=MIBO-W01
MIBO_SITE=JP01
MIBO_DATA_ROOT=/srv/mibo-data
MIBO_UI_CONFIGURATION=/srv/mibo-private/ui_configuration.W01.json
MIBO_OPERATOR_ROSTER=/srv/mibo-private/operator_roster.W01.json
MIBO_PROVIDER_FREEZE=/srv/mibo-private/provider_freeze.W01.json
MIBO_PREWAVE_BUNDLE_DIR=/srv/mibo-private/MIBO-W01-JP01-prewave
MIBO_API_EVIDENCE_DIR=/srv/mibo-private/MIBO-W01-JP01-api-preflight

# Optional exploratory API Shadow. Leave MIBO_API_SHADOW_FREEZE blank if it is not being run.
MIBO_API_SHADOW_FREEZE=
MIBO_API_SHADOW_EVIDENCE_DIR=/srv/mibo-private/MIBO-W01-JP01-api-shadow-preflight
MIBO_API_SHADOW_BUNDLE_DIR=/srv/mibo-private/MIBO-W01-JP01-api-shadow

# Optional non-confirmatory smoke-test sentinels. Leave disabled by default.
MIBO_API_SMOKE_TEST=DISABLED
MIBO_API_SHADOW_SMOKE_TEST=DISABLED

# Provider credentials. Populate only those required by prospectively frozen eligible paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
