[Unit]
Description=MIBO Core v2.0 API-only wave executor
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=oneshot
User=mibo
Group=mibo
WorkingDirectory=/opt/mibo-core
EnvironmentFile=/etc/mibo/mibo-core-v2.env
ExecStart=/usr/bin/python3 /opt/mibo-core/automation/core_v2_waiter.py --protocol ${MIBO_CORE_V2_PROTOCOL} --wave ${MIBO_CORE_V2_WAVE} --manifest ${MIBO_CORE_V2_MANIFEST} --freeze ${MIBO_CORE_V2_FREEZE} --authorization ${MIBO_CORE_V2_AUTHORIZATION} --data-root ${MIBO_DATA_ROOT}
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mibo-data /srv/mibo-private
UMask=0077

[Install]
WantedBy=multi-user.target
